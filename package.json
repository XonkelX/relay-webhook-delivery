{
  "name": "relay-webhook-delivery",
  "version": "0.0.0",
  "private": true,
  "description": "A reliable outbound webhook delivery platform.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier . --write",
    "format-check": "prettier . --check",
    "test:e2e": "playwright test",
    "check:cost": "node scripts/check-cost-guardrails.mjs",
    "db:migrate:local": "cd apps/console && wrangler d1 migrations apply relay-local --local"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
